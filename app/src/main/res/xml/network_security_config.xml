<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext policy (Campaign 3 P3): the MJPEG video stream is served by the
     robot over plain HTTP (no TLS on the robot), so cleartext is permitted only
     for the robot host instead of globally (usesCleartextTraffic="true" removed).
     The default robot hotspot is 192.168.77.1; if a user configures another host
     over cleartext HTTP, add that host here (base-config stays cleartext-off).
     Rationale: MEMORY.md "Campaign 3". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.77.1</domain>
    </domain-config>
</network-security-config>

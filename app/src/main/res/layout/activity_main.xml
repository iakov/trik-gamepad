<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context=".MainActivity">

    <com.trikset.gamepad.mjpeg.MjpegView
        android:id="@+id/video"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:contentDescription="@string/video_description"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <TextView
        android:id="@+id/videoPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/video_placeholder"
        android:textColor="@android:color/darker_gray"
        android:textSize="18sp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginBottom="50dp">

        <com.trikset.gamepad.SquareTouchPadLayout
            android:id="@+id/leftPad"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="10dp"
            android:layout_alignParentStart="true"
            android:contentDescription="@string/left_pad_description"
            android:background="@drawable/touchpad_shape"
            android:src="@drawable/oxygen_actions_transform_move_icon" />

        <com.trikset.gamepad.SquareTouchPadLayout
            android:id="@+id/rightPad"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="10dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="@string/right_pad_description"
            android:background="@drawable/touchpad_shape"
            android:src="@drawable/oxygen_actions_transform_move_icon" />

    </RelativeLayout>


    <Button
        android:id="@+id/btnSettings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="0dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:contentDescription="@string/settings_button_description"
        android:focusableInTouchMode="false"
        android:padding="0dp"
        android:background="@drawable/btn_settings"
        />

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        >

    </LinearLayout>

    <!-- Persistent connection status: "Connected to host:port" / "Connecting…" /
         "Disconnected — tap to connect". Tapping it retries the connection
         (ConnectionFeedback.attach). Kept AFTER the gear button in the child
         list per the defensive convention below. -->
    <TextView
        android:id="@+id/connectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnSettings"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/connection_status_background"
        android:clickable="true"
        android:contentDescription="@string/connection_status_description"
        android:focusable="true"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <!-- Kept as the LAST child of main (defensive convention): MainActivity calls
         controlsOverlay.bringToFront(), which reorders the children at runtime
         (video, btnSettings, buttons, ..., controlsOverlay) — keep new children
         after the gear button so nothing nudges it out of its rendered position
         (instrumented tests locate it by id, but a stable order keeps manual
         inspection and any index-based tooling predictable). The spinner is
         centered via layout params and stays under the brought-to-front controls
         overlay. -->
    <ProgressBar
        android:id="@+id/videoLoading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/video_loading_background"
        android:padding="14dp"
        android:visibility="gone" />


</RelativeLayout>

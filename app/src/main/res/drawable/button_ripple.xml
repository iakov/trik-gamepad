<?xml version="1.0" encoding="utf-8"?>
<!-- Magic-button background: the Material ripple overlays the existing pressed-state selector
     (so the press fill and the ripple coexist; the brand fill + stroke colors are unchanged). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/greendark" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/greenlight" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/magic_button_fill_default" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/greendark" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- Type 1 HUD: glass capsule hosting the round magic buttons (fake glass — translucent fill,
     brand-green stroke). Applied to the `@+id/buttons` container in activity_main.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/hud_glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/greenlight" />
    <corners android:radius="40dp" />
    <padding
        android:left="10dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="6dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Type 1 HUD: round glass disc behind each robot-chip connection-status glyph (control/video).
     The glyph color (set at runtime) carries the state; the disc is neutral chrome. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/hud_glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/hud_glass_fill_strong" />
</shape>
